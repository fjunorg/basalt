# Basalt 环境变量模板（真源：pkg/kernel/config/config.go + cmd/basalt/serve.go）
#
# 用法：cp .env.example .env 后按需修改。
# 注意：二进制本身只读进程环境变量、不解析 .env 文件——
#   本文件供 systemd EnvironmentFile= / docker run --env-file / compose env_file 使用。
# 注释一律整行书写（dotenv 惯例不剥离行内注释，避免值被污染）。

# ─── 服务 ───────────────────────────────────────────────
# HTTP 监听地址。默认 :8080
BASALT_ADDR=:8080

# 运行环境：dev | test | staging | prod。默认 dev。
# prod 下强制要求显式 BASALT_JWT_SECRET 与 BASALT_BOOTSTRAP_ADMIN_PASS，否则拒绝启动。
BASALT_ENV=dev

# ─── 安全 ───────────────────────────────────────────────
# JWT 签名密钥。默认 basalt-dev-secret（仅 dev/test 可用）；prod 必须显式配置强随机值。
BASALT_JWT_SECRET=

# 访问令牌有效期（分钟）。默认 120。
BASALT_TOKEN_TTL_MIN=120

# 首启引导管理员用户名。默认 admin。
BASALT_BOOTSTRAP_ADMIN_USER=admin

# 首启引导管理员口令。默认 Basalt@2026（仅 dev/test 可用）；prod 必须显式覆盖。
BASALT_BOOTSTRAP_ADMIN_PASS=

# ─── 可观测 ─────────────────────────────────────────────
# OTLP/HTTP 遥测导出地址（如 http://otel-col:4318）。默认空 = 可观测全部 no-op（离线零依赖）。
BASALT_OTEL_ENDPOINT=

# ─── 国密 ───────────────────────────────────────────────
# 内核摘要算法：sha256（默认）| sm3（国密 GB/T 32905，信创推荐，影响审计链哈希）
# | sm2（国密套件：SM3 摘要 + SM2 签名，SM2 官方向量验证 GB/T 32918.2）。
BASALT_CRYPTO_ALGO=sha256

# SM2 签名私钥（hex，32 字节/64 字符）。供 BASALT_CRYPTO_ALGO=sm2 与
# 链尾签名使用；留空时启用相关能力将进程内生成（重启换钥，仅适合开发）。
BASALT_SM2_PRIVATE_KEY=
# SM2 用户标识 UID（默认国标 1234567812345678）。
BASALT_SM2_UID=
# 审计链尾签名开关（默认 off）：on 时 POST /api/v1/audit/chain/signatures
# 可对链尾签名，防"整库重算哈希链"伪造历史（需 sqlite 持久化链）。
BASALT_SM2_CHAIN_SIGN=

# ─── 持久化 ─────────────────────────────────────────────
# 存储后端：memory（默认，零依赖，重启即丢）| sqlite（GORM 落盘：身份/租户/审计链/配额）。
BASALT_STORAGE=memory

# sqlite 数据库文件路径（BASALT_STORAGE=sqlite 时生效）。默认 basalt.db（当前目录）。
# 容器部署建议指向持久卷，如 /var/lib/basalt/basalt.db。
BASALT_DB_DSN=

# ─── 租户隔离（dedicated-db） ──────────────────────────
# 租户级独立库路由开关：off（默认，现状行为不变）| on（按租户 isolation_mode
# 路由到专属库）。详见 docs/tenant-isolation.md。
BASALT_TENANT_ROUTING=off

# 租户专属库 DSN 注入（模式变量，按需添加，勿直接复制本行）：
# 变量名 = BASALT_TENANT_DSN_<REF大写>（租户 DBRef 非字母数字字符转下划线，
# 如 db_ref=gov-db → BASALT_TENANT_DSN_GOV_DB）。凭据只经环境变量注入、不落库；
# 未配置该 DSN 时对应用户请求明确报错（ErrTenantDBUnavailable），绝不静默回退主库。
# 示例：# BASALT_TENANT_DSN_GOV_DB=/var/lib/basalt/tenants/gov.db

# 文件上传目录。默认 uploads（当前目录）。
BASALT_UPLOAD_DIR=uploads

# 优雅关闭总预算（秒）。默认 15。
BASALT_SHUTDOWN_TIMEOUT_SEC=15

# ─── AI 提供方（OpenAI 兼容端点，如 vLLM/Ollama/Qwen/GLM） ──
# 提供方 API 地址；留空 = 不注册 AI 网关提供方。例：http://vllm:8000
BASALT_AI_PROVIDER_URL=

# 提供方注册名（chat 提供方展示标识）。
BASALT_AI_PROVIDER_NAME=

# 提供方 API Key。
BASALT_AI_PROVIDER_KEY=

# RAG 向量化模型名（OpenAI 兼容 /v1/embeddings 端点的模型标识，如 bge-m3）。
# 复用上方的 BASALT_AI_PROVIDER_URL/KEY；各兼容端点模型名不一，故不设默认值——
# 未配置（或 PROVIDER_URL 为空）时向量化请求明确报错拒绝（不静默跳过），
# 文档注册/分块仍可用，仅 embedded 环节不可用。真源：pkg/modules/rag/embedding.go
BASALT_AI_EMBED_MODEL=
