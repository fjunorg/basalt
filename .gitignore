# ===== 构建产物 =====
# go build 输出（Makefile: build）
/bin/
# 根目录裸 go build 产物（无 -o 时 go build ./cmd/basalt 输出到当前目录）
/basalt
# 交叉编译产物（Makefile: cross-build）——仅根级；console/dist 是 go:embed 依赖，有意保留入库
/dist/
# Go 测试二进制与覆盖率
*.test
coverage.out

# ===== 前端 =====
console/node_modules/
# go:embed hash 守护基线（运行时写入，不应入库）
console/.src-hash
console/.dist-hash

# ===== 运行时数据与敏感文件 =====
uploads/
*.db
*.db-journal
*.db-wal
*.db-shm
*.pid
.env
.env.*
.env.local
!.env.example

# ===== 系统与编辑器 =====
.DS_Store
.idea/
.vscode/
